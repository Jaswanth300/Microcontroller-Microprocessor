# MPMC Coursework Git Ignore File

# Binaries and Installers
*.exe
*.dll
*.ocx
*.tlb
*.cab
*.CAB
*.msi
*.iso

# Simulator Kit and Setup Installations
8085/8085Setup.txt/
8085/*.exe
8085/*.LOG
8085/*.log
8086/EMU8086/
8086/*.exe

# Temporary Microsoft Office / Word Lock Files
~$*.docx
~$*.doc
~$*.pptx
~$*.xlsx

# Python and System Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.tmp
*.temp

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo

# OS Metadata
Thumbs.db
Desktop.ini
.DS_Store

# Temporary scratch and staging folders
scratch/
scratch_*/
.system_generated/
